package: "com.android.webapp.flags"
container: "com.android.webapp"

flag {
    name: "enable_web_app_service"
    namespace: "desktop_native_framework"
    description: "Enables the Web App Installer system service and SDK APIs."
    is_exported: true
    bug: "432147348"
}
