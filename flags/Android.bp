package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aconfig_declarations {
    name: "com.android.webapp.flags-aconfig",
    package: "com.android.webapp.flags",
    container: "com.android.webapp",
    exportable: true,
    srcs: ["*.aconfig"],
}

java_aconfig_library {
    name: "com.android.webapp.flags-aconfig-java",
    aconfig_declarations: "com.android.webapp.flags-aconfig",
    defaults: ["framework-minus-apex-aconfig-java-defaults"],
    min_sdk_version: "36",
    apex_available: [
        "com.android.webapp",
    ],
    visibility: [
        "//packages/modules/WebApp:__subpackages__",
    ],
}

java_aconfig_library {
    name: "com.android.webapp.flags-aconfig-exported-java",
    aconfig_declarations: "com.android.webapp.flags-aconfig",
    defaults: ["framework-minus-apex-aconfig-java-defaults"],
    min_sdk_version: "36",
    mode: "exported",
    apex_available: [
        "//apex_available:platform",
        "com.android.webapp",
    ],
    visibility: [
        "//frameworks/base:__subpackages__",
        "//packages/modules/WebApp:__subpackages__",
    ],
}
