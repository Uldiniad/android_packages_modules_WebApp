package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "WebAppTemplate",
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    sdk_version: "module_current",
    min_sdk_version: "36",

    static_libs: [
        "android-browser-helper",
    ],

    // We need res IDs file to have stable resource IDs for the minted APK.
    emit_res_ids: true,

    // TODO(b/462577557): Re-enable optimizations after investigating build crashes.
    // optimize: {
    //    enabled: true,
    //    shrink: true,
    //    shrink_resources: true,
    //},

    licenses: [
        "Android-Apache-2.0",
        "opensourcerequest",
    ],
}

genrule {
    name: "WebAppTemplateBundle",
    tools: ["webapp-template-builder"],

    // The srcs order must be kept in sync with webapp-template-builder.py.
    device_common_srcs: [
        "AndroidManifest.xml.mustache",
        // This comment prevents bpfmt from sorting the files incorrectly.
        ":WebAppTemplate",
        ":WebAppTemplate{.res-ids.txt}",
        "res/**/*",
    ],
    out: ["webapp-template.zip"],
    cmd: "$(location webapp-template-builder) $(out) $(in)",
}

python_binary_host {
    name: "webapp-template-builder",
    main: "webapp-template-builder.py",
    srcs: ["webapp-template-builder.py"],
}

prebuilt_res {
    name: "webapp-template-res",
    src: ":WebAppTemplateBundle",
    filename: "webapp-template.zip",
}
