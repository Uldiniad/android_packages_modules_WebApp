package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "framework-webapp-aidl",
    local_include_dir: "aidl",
    srcs: ["aidl/**/*.aidl"],
    // AIDL interfaces are not exposed (all @hide). Therefore they are unstable. Mainline modules
    // are required to hide all AIDL interfaces.
    unstable: true,
    backend: {
        java: {
            sdk_version: "module_current",
            min_sdk_version: "36",
            apex_available: ["com.android.webapp"],
        },
    },
}

java_sdk_library {
    name: "framework-webapp",
    srcs: [
        "java/**/*.java",
    ],
    static_libs: [
        "framework-webapp-aidl-java",
    ],
    libs: [
        "com.android.webapp.flags-aconfig-exported-java",
        "framework-annotations-lib",
    ],
    defaults: ["framework-module-defaults"],
    permitted_packages: [
        "android.content.pm.webapp",
        "com.android.webapp",
    ],
    sdk_version: "module_current",
    min_sdk_version: "36",
    apex_available: ["com.android.webapp"],
    aconfig_declarations: [
        "com.android.webapp.flags-aconfig",
    ],
}
