package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// To generate WebappStatsLog for logging.
genrule {
    name: "statslog-webapp-java-gen",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --java $(out) --module webapp --javaPackage com.android.webapp.service --javaClass WebappStatsLog",
    out: ["com/android/webapp/service/WebappStatsLog.java"],
}

java_library {
    name: "statslog-webapp",
    sdk_version: "module_current",
    min_sdk_version: "36",
    srcs: [
        ":statslog-webapp-java-gen",
    ],
    libs: [
        // To add StatsLog as a dependency of the generated file.
        "framework-statsd.stubs.module_lib",
    ],
    apex_available: ["com.android.webapp"],
}

android_app {
    // This mainline SDK will be enabled using RELEASE_WEBAPP_MODULE flag
    enabled: select(release_flag("RELEASE_WEBAPP_MODULE"), {
        true: true,
        false: false,
    }),

    name: "WebAppService",
    srcs: [
        "java/**/*.kt",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    sdk_version: "module_current",
    min_sdk_version: "36",

    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.core_core",
        "androidx.lifecycle_lifecycle-service",
        "apksig",
        "bouncycastle-webapp",
        "com.android.webapp.flags-aconfig-java",
        "guava",
        "jmustache",
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "kotlinx_serialization_json",
        "statslog-webapp",
    ],
    kotlin_plugins: [
        "kotlin-serialize-compiler-plugin",
    ],
    libs: [
        "framework-annotations-lib",
        "framework-webapp-aidl-java",
        "framework-webapp.stubs.module_lib",
    ],

    flags_packages: ["com.android.webapp.flags-aconfig"],

    // This app requires several privileged permissions
    privileged: true,
    privapp_allowlist: ":privapp_allowlist_com.android.webapp.service.xml",

    certificate: ":com.android.webapp.certificate",

    updatable: true,
    apex_available: ["com.android.webapp"],

    // Enable aggressive optimization to reduce package size
    optimize: {
        optimize: true,
        shrink: true,
        shrink_resources: true,
        proguard_flags_files: ["proguard.flags"],
    },

    licenses: [
        "Android-Apache-2.0",
        "opensourcerequest",
    ],
}
