package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "WebAppService",
    srcs: [
        "java/**/*.kt",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    sdk_version: "module_current",
    min_sdk_version: "36",

    static_libs: [
        "androidx.lifecycle_lifecycle-service",
        "apksig",
        "bouncycastle-webapp",
        "com.android.webapp.flags-aconfig-java",
        "framework-webapp-aidl-java",
        "jmustache",
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "kotlinx_serialization_json",
    ],
    kotlin_plugins: [
        "kotlin-serialize-compiler-plugin",
    ],

    libs: [
        "framework-annotations-lib",
    ],

    flags_packages: ["com.android.webapp.flags-aconfig"],

    // This app requires several privileged permissions
    privileged: true,
    privapp_allowlist: ":privapp_allowlist_com.android.webapp.service.xml",

    certificate: ":com.android.webapp.certificate",

    updatable: true,
    apex_available: ["com.android.webapp"],

    licenses: [
        "Android-Apache-2.0",
        "opensourcerequest",
    ],
}
