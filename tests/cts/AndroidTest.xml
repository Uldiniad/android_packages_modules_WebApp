<configuration description="Test config for MtsWebAppTestCases">
    <option name="test-suite-tag" value="cts" />
    <option name="config-descriptor:metadata" key="component" value="webapp" />
    <option name="config-descriptor:metadata" key="parameter" value="not_instant_app" />
    <option name="config-descriptor:metadata" key="parameter" value="multi_abi" />
    <option name="config-descriptor:metadata" key="parameter" value="secondary_user" />
    <option name="config-descriptor:metadata"
            key="mainline-param" value="com.google.android.webapp.apex" />
    <option name="not-shardable" value="true" />
    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="run-command" value="sh -c 'echo &quot;chrome --disable-fre&quot; > /data/local/tmp/chrome-command-line'" />
        <option name="run-command" value="chmod 644 /data/local/tmp/chrome-command-line" />
        <option name="run-command" value="am force-stop com.android.chrome" />
        <option name="run-command" value="settings put global package_verifier_user_consent -1" />
        <option name="teardown-command" value="settings delete global package_verifier_user_consent" />
        <option name="teardown-command" value="rm /data/local/tmp/chrome-command-line" />
        <option name="teardown-command" value="am force-stop com.android.chrome" />
    </target_preparer>
    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="cleanup-apks" value="true" />
        <option name="test-file-name" value="MtsWebAppTestCases.apk" />
    </target_preparer>
    <test class="com.android.tradefed.testtype.AndroidJUnitTest" >
        <option name="package" value="com.android.webapp.tests" />
        <option name="runtime-hint" value="1m1s" />
        <option name="hidden-api-checks" value="false" />
        <option name="isolated-storage" value="false" />
    </test>

    <!-- Only run MtsWebAppTestCases if the WebApp Mainline module is installed.
         Otherwise, the device is not required to pass these test cases. -->
    <object type="module_controller"
            class="com.android.tradefed.testtype.suite.module.MainlineTestModuleController">
        <option name="mainline-module-package-name" value="com.google.android.webapp" />
    </object>

    <!-- Disable the tests on Wear/Auto/TV. -->
    <object type="module_controller"
            class="com.android.tradefed.testtype.suite.module.DeviceFeatureModuleController">
        <option name="forbidden-feature" value="android.hardware.type.automotive"/>
        <option name="forbidden-feature" value="android.software.leanback"/>
        <option name="forbidden-feature" value="android.hardware.type.television"/>
        <option name="forbidden-feature" value="android.hardware.type.watch"/>
    </object>
</configuration>
